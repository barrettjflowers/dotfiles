# Ignore everything
*

# Except...
!*.vimrc
!*.vim
!*.zshrc
!*.bashrc
!.gitignore
!.gitignore_global
!.bashrc
!.codeium
!.fzf
!/.hammerspoon/
!/.hammerspoon/*
!.parsec
!.putty
!/Markdown/
!/Markdown/*
!/.scripts/
