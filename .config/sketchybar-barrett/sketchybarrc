PLUGIN_DIR="$CONFIG_DIR/plugins"

##### Bar Appearance #####
sketchybar --bar \
  position=top \
  height=32 \
  y_offset=12 \
  margin=12 \
  corner_radius=10 \
  blur_radius=30 \
  shadow=on \
  color=0x30AAAAAA

# default styles
default=(
  padding_left=4
  padding_right=4
  label.padding_left=6
  label.padding_right=6
  icon.padding_left=0
  icon.padding_right=6
  icon.color=0xFFFFFFFF
  label.color=0xFFFFFFFF
  background.color=0x40AAAAAA
  background.corner_radius=5
  background.height=20
  background.width=20
  icon.font="SF Pro Text:Medium:14.0"
  label.font="SF Pro Text:Medium:14.0"
)
sketchybar --default "${default[@]}"

