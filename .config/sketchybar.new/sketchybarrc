PLUGIN_DIR="$CONFIG_DIR/plugins"

##### Bar Appearance #####
sketchybar --bar \
  position=top \
  height=38 \
  blur_radius=100 \
  color=0x10000000\
  corner_radius=0 \
  margin=0 \
  padding_left=6 \
  padding_right=6 \
  y_offset=0 \
  topmost=on \
  display=1

# default styles
default=(
  padding_left=4
  padding_right=4
  label.padding_left=6
  label.padding_right=6
  icon.padding_left=0
  icon.padding_right=6
  icon.color=0xFFFFFFFF
  label.color=0xFFFFFFFF
  background.corner_radius=5
  background.height=18
  background.width=20
  icon.font="SF Pro Text:Medium:14.0"
  label.font="SF Pro Text:Medium:14.0"
)
  #background.color=0x1AFFFFFF
sketchybar --default "${default[@]}"

# Personal Status
sketchybar --add item focus left\
           --set focus script="$PLUGIN_DIR/focus_status.sh" \
		   click_script="open -a 'Focus'" \
             update_freq=5 \
             label.drawing=on \
             label.padding_left=0 \
             label.padding_right=6
# Spaces
SPACE_ICONS=("􀥳" "􀌥" "􀪏" "4" "5" "6" "7" "8" "9")
for i in "${!SPACE_ICONS[@]}"
do
  sid="$(($i+1))"
  space=(
    space="$sid"
    icon="${SPACE_ICONS[i]}"
    icon.padding_left=8
    icon.padding_right=8
    padding_left=4
    padding_right=0
    background.corner_radius=5
    label.drawing=off
    script="$PLUGIN_DIR/space.sh"
  )
  sketchybar --add space space."$sid" left --set space."$sid" "${space[@]}"
done

sketchybar --add item front_app left \
           --set front_app icon.drawing=off script="$PLUGIN_DIR/front_app.sh" \
		   click_script="$PLUGIN_DIR/menu_items.sh" \
           --subscribe front_app front_app_switched

sketchybar --add event spotify_change $SPOTIFY_EVENT \
    --add item spotify q \
    --set spotify \
    icon.font="$FONT_FACE:Bold:20.0" \
    label.drawing=on \
    label.padding_left=4 \
    padding_right=0 \
    script="$PLUGIN_DIR/spotify.sh" \
	click_script="osascript -e 'tell application \"Spotify\" to playpause'" \
    update_freq=15 \

# right items

sketchybar --add item clock right \
           --set clock update_freq=15 script="$PLUGIN_DIR/clock.sh" \
		   padding_left=0 \
		   click_script="osascript -e 'tell application \"System Events\" to keystroke \"\\\\\" using {command down, shift down}'"

sketchybar --add item control_center right \
		   --set control_center label="􀜊" icon.font="$FONT_FACE:Bold:20.0" label.drawing=on \
		   padding_right=0 \
		   padding_left=0 \
		   click_script="$PLUGIN_DIR/control_center.sh"

sketchybar --add item battery right \
           --set battery \
             update_freq=120 \
             script="$PLUGIN_DIR/battery.sh" \
			 icon.padding_right=0 \
			 padding_left=4 \
			 padding_right=0 \
			 click_script="open -a 'AlDente'"

sketchybar --add item weather right \
           --set weather script="$PLUGIN_DIR/weather.sh" \
             update_freq=1200 \
             icon.padding_left=4 \
             icon.padding_right=4 \


sketchybar --add item cpu e \
           --set cpu \
             script="$PLUGIN_DIR/cpu.sh" \
			 click_script="alacritty -e btop" \
             icon.drawing=off \
             label.padding_right=4 \
             padding_left=0 \
             update_freq=30

##### Force Initial Update #####
sketchybar --update
