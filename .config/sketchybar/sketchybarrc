PLUGIN_DIR="$CONFIG_DIR/plugins"
source "$HOME/.config/colors/colors.sh"

# main bar
sketchybar --bar \
  position=top \
  height=33 \
  y_offset=12 \
  margin=12 \
  corner_radius=10 \
  blur_radius=20 \
  border_width=1 \
  border_color="$BACKGROUND" \
  background=on \
  shadow=on \
  color=0x30333333\
  sticky=on \
  display=all

# default styles
default=(
  padding_left=6
  padding_right=4
  label.padding_left=4
  label.padding_right=1
  icon.padding_left=0
  icon.padding_right=4
  background.color=
  background.corner_radius=6
  background.height=20
  background.width=18
  label.color="${TEXT}"
  icon.color="${TEXT}"
  icon.font="Menlo:Bold:15.0"
  label.font="Menlo:Bold:15.0"
)

sketchybar --default "${default[@]}"

# init vimspoon indicator
sketchybar --add item vim left

# do not disturb indicator
sketchybar --add item focus left\
           --set focus script="$PLUGIN_DIR/focus_status.sh" \
             update_freq=5 \
             label.drawing=on \
             label.padding_left=0 \
						 padding.left=0 \
             label.padding_right=6

# this is so dumb... but it looks nice. drawing the background first
# then hacking the padding of the spaces to overlap it
# if you do a negative left padding and a positive right padding
# you can change the absolute position of the item since there is no
# x_offset property.

# spaces
sketchybar --add item space-background left \
					 --set space-background \
					 background.drawing=on \
					 width=160

SPACE_ICONS=("1" "2" "3" "4" "5" "6")
KEYCODES=(18 19 20 21 23 22 26 28 25)

for i in "${!SPACE_ICONS[@]}"; do
  sid="$((i+1))"

  space=(
    space="$sid"
    icon="${SPACE_ICONS[i]}"
    icon.padding_left=8
    icon.padding_right=8
  	padding_left=-160
    padding_right=157
    label.drawing=off
    script="$PLUGIN_DIR/space.sh"
)

  sketchybar --add space space."$sid" left \
             --set space."$sid" "${space[@]}" \
             associated_item=spaces.container
done

# focused app
sketchybar --add item front_app left \
    		   --animate sin 10 \
           --set front_app \
					 icon.drawing=off \
					 background.drawing=off \
                     background.color="" \
					 padding_left=-155 \
					 script="$PLUGIN_DIR/front_app.sh" \
           --subscribe front_app front_app_switched
# media
sketchybar --add item media q \
           --set media \
           script="$PLUGIN_DIR/media-control.sh" \
           icon.drawing=off \
           label.drawing=on \
           padding_right=22 \
           label.padding_left=0 \
					 scroll_texts=on \
           label.max_chars=28 \
           update_freq=5

# notch items
sketchybar --add item battery e \
           --set battery \
           update_freq=60 \
			     padding_right=8 \
			     padding_left=24 \
				 icon.padding_right=6 \
           script="$PLUGIN_DIR/battery.sh"

sketchybar --add item cpu e \
           --set cpu \
           script="$PLUGIN_DIR/cpu.sh" \
           icon.drawing=off \
           update_freq=5 

sketchybar --add item mem e \
           --set mem \
           label.drawing=on \
           script="$PLUGIN_DIR/memory.sh" \
		       update_freq=15

# right items
sketchybar --add item clock right \
           --set clock update_freq=15 script="$PLUGIN_DIR/clock.sh" \
		       padding_left=8 \
		       padding_right=10 \
		       label.padding_left=0 \
		       update_freq=1

sketchybar --add item notifications right \
           --animate sin 10 \
           --set notifications \
		       label.color="$ACCENT_SECONDARY" \
           script="$PLUGIN_DIR/notifications.sh" \
           update_freq=3

# force init
sketchybar --update

# bootstraps
brew services restart borders
killall Hammerspoon; open -a Hammerspoon # vimspoon integration
