PLUGIN_DIR="$CONFIG_DIR/plugins"
source "$HOME/.config/colors/colors.sh"

##### Bar Appearance #####
sketchybar --bar \
  position=top \
  height=32 \
  y_offset=12 \
  margin=12 \
  corner_radius=10 \
  blur_radius=80 \
  background=off \
  shadow=on \
  color=0x00222726 \
  sticky=on \
  display=1

# default styles
default=(
  padding_left=6
  padding_right=6
  label.padding_left=6
  label.padding_right=8
  icon.padding_left=0
  icon.padding_right=6
  background.color="${BACKGROUND}"
  background.corner_radius=12
  background.height=28
  background.width=20
  label.color="${TEXT}"
  icon.color="${TEXT}"
  icon.font="Menlo:Bold:13.5"
  label.font="Menlo:Bold:13.5"
)
sketchybar --default "${default[@]}"

# Personal Status
sketchybar --add item focus left\
           --set focus script="$PLUGIN_DIR/focus_status.sh" \
             update_freq=5 \
             label.drawing=on \
             label.padding_left=0 \
						 padding.left=0 \
             label.padding_right=6

# this is so dumb... but it looks nice. drawing the background first
# then hacking the padding of the spaces to overlap it
# if you do a negative left padding and a positive right padding
# you can change the absolute position of the item since there is no
# x_offset proprty.

sketchybar --add item space-background left \
					 --set space-background background.color="${BACKGROUND}" \
					 background.drawing=on \
					 width=170

SPACE_ICONS=("1" "2" "3" "4" "5" "6")
KEYCODES=(18 19 20 21 23 22 26 28 25)

for i in "${!SPACE_ICONS[@]}"; do
  sid="$((i+1))"

  space=(
    space="$sid"
    icon="${SPACE_ICONS[i]}"
    icon.padding_left=8
    icon.padding_right=8
		background.drawing=off
		padding_left=-150
    padding_right=150
    label.drawing=off
    script="$PLUGIN_DIR/space.sh"
    click_script="osascript -e 'tell application \"System Events\" \
      to key code ${KEYCODES[i]} using control down'"
  )

  sketchybar --add space space."$sid" left \
    --set space."$sid" "${space[@]}" \
    associated_item=spaces.container
done

sketchybar --add item front_app left \
		   --animate sin 10 \
           --set front_app icon.drawing=off padding_left=-125 script="$PLUGIN_DIR/front_app.sh" \
		   click_script="$PLUGIN_DIR/front_app.sh" \
           --subscribe front_app front_app_switched

sketchybar --add item notch_left q \
 --animate sin 10 \
  --set notch_left \
    label.drawing=on \
	  label.padding_left=0 \
		padding_right=14 \
    script="$PLUGIN_DIR/spotify.sh" \
		update_freq=15 \
    click_script="$PLUGIN_DIR/spotify_vol_slider.sh"

# Right Items
sketchybar --add item clock right \
           --set clock update_freq=15 script="$PLUGIN_DIR/clock.sh" \
		   padding_left=8 \
		   padding_right=4 \
		   label.padding_left=0 \
		   update_freq=1 \
		   click_script="osascript -e 'tell application \"System Events\" to keystroke \"\\\\\" using {command down, shift down}'"

sketchybar --add item battery right \
           --set battery \
             update_freq=120 \
             script="$PLUGIN_DIR/battery.sh" \
			 icon.padding_right=0 \
			 padding_left=4 \
			 icon.padding_left=4 \
			 padding_right=0 \
			 click_script="open -a 'AlDente'"

